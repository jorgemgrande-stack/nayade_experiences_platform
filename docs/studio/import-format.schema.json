{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "site": {
      "type": "object",
      "properties": {
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
        }
      },
      "additionalProperties": false
    },
    "media": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "originalFilename": {
            "type": "string",
            "maxLength": 256
          },
          "alt": {
            "type": "string",
            "maxLength": 300
          },
          "license": {
            "type": "string",
            "maxLength": 200
          },
          "credit": {
            "type": "string",
            "maxLength": 300
          },
          "sourceNote": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "sourceUrl"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
          },
          "translationOf": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "status": {
            "default": "draft",
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "seo": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "additionalProperties": false
          },
          "blocks": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,40}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "hero",
                    "text",
                    "image",
                    "gallery",
                    "button",
                    "columns",
                    "contact_form",
                    "separator",
                    "heading",
                    "features",
                    "testimonials",
                    "faq",
                    "cta",
                    "video",
                    "products",
                    "blog_posts",
                    "slideshow",
                    "carousel",
                    "cards",
                    "form",
                    "pricing",
                    "stats",
                    "logos",
                    "section",
                    "modal"
                  ]
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "style": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "locale": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
                }
              },
              "required": [
                "type",
                "data"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "title",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "menu": {
      "type": "object",
      "properties": {
        "header": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pageSlug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "pageSlug"
            ],
            "additionalProperties": false
          }
        },
        "footer": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pageSlug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "pageSlug"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
